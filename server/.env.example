# IARE Connect — server environment variables
# Copy this file to `.env` and fill in real values. Never commit the real `.env`.

# Port the Express API listens on
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/iare-connect

# Secret used to sign JWTs — use a long random string (64+ characters recommended)
JWT_SECRET=

# How long a login session stays valid (examples: 1d, 12h, 60m)
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s) for CORS (the Vite dev server), comma-separated.
# Vite moves to 5174 automatically when 5173 is busy, so both are listed.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Set to "production" when deploying behind HTTPS (makes the auth cookie Secure)
NODE_ENV=development

# Initial Admin account created by `npm run seed:admin`.
# There is NO public Admin registration — this is the only way the first Admin is created.
SEED_ADMIN_EMAIL=admin@iare.ac.in
SEED_ADMIN_PASSWORD=
